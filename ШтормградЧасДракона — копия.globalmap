:350,"resources":{"Supplies":6,"Equipment":5,"Intelligence":5,"Alchemy":3,"AncientText":"Карта Руин","specialItems":[]}},{"id":"clan_5","name":"Круг - Тумана Валлийцы","trustLevel":2,"gold":180,"resources":{"Supplies":3,"Equipment":3,"Intelligence":2,"Alchemy":1,"AncientText":"","specialItems":[]}},{"id":"clan_6","name":"Бранденбуржцы","trustLevel":1,"gold":100,"resources":{"Supplies":2,"Equipment":2,"Intelligence":4,"Alchemy":0,"AncientText":"","specialItems":[]}},{"id":"clan_7","name":"Туата де Дананн из Ленстера","trustLevel":1,"gold":120,"resources":{"Supplies":3,"Equipment":2,"Intelligence":2,"Alchemy":1,"AncientText":"","specialItems":[]}},{"id":"clan_8","name":"Фир Болги из Манстера","trustLevel":2,"gold":180,"resources":{"Supplies":2,"Equipment":4,"Intelligence":1,"Alchemy":2,"AncientText":"","specialItems":[]}},{"id":"clan_9","name":"Воины Света Копьё Серебряных Клинков","trustLevel":1,"gold":130,"resources":{"Supplies":2,"Equipment":2,"Intelligence":4,"Alchemy":1,"AncientText":"","specialItems":[]}},{"id":"clan_10","name":"Избранные Стеклянной Башни","trustLevel":2,"gold":210,"resources":{"Supplies":4,"Equipment":4,"Intelligence":2,"Alchemy":1,"AncientText":"","specialItems":[]}},{"id":"clan_11","name":"Коннахты","trustLevel":1,"gold":110,"resources":{"Supplies":3,"Equipment":2,"Intelligence":3,"Alchemy":0,"AncientText":"","specialItems":[]}},{"id":"clan_12","name":"Баронство Мортимер ","trustLevel":3,"gold":320,"resources":{"Supplies":5,"Equipment":4,"Intelligence":4,"Alchemy":3,"AncientText":"","specialItems":[]}},{"id":"clan_13","name":"Гардикоры Его Величества Короля Франкии","trustLevel":1,"gold":140,"resources":{"Supplies":4,"Equipment":4,"Intelligence":1,"Alchemy":0,"AncientText":"","specialItems":[]}},{"id":"clan_14","name":"Семьи Вероны","trustLevel":2,"gold":190,"resources":{"Supplies":2,"Equipment":3,"Intelligence":3,"Alchemy":2,"AncientText":"","specialItems":[]}},{"id":"clan_15","name":"Королевство Островов","trustLevel":1,"gold":125,"resources":{"Supplies":3,"Equipment":4,"Intelligence":1,"Alchemy":1,"AncientText":"","specialItems":[]}}],"adventurers":[],"missions":[{"id":"event_mseszuqn","title":"Затонувший Корабль","desc":"Слухи подтверждаются. Контрабандный галеон, перевозивший то, за чем охотятся сразу несколько влиятельных фракций, пропал. Скорее всего, он сбился с курса в плотных туманах Ленстера так и не пройдя до городов Ульстера.\nВаша текущая позиция в Ульстере позволяет выдвинуться к предполагаемому месту крушения первыми. Орден настоятельно рекомендует опередить сторонних наемников и изъять содержимое капитана раньше, чем до него доберутся фоморы или грабители.","reqResource":"Supplies","dc":12,"type":"STORY","lifespan":3,"maxLifespan":3,"x":82,"y":37,"region":"ЛЕНСТЕР","startDay":1,"goldReward":0,"checks":[{"id":"event_mseszuqn_stage_1","label":"Этап 1","reqResource":"Supplies","dc":12,"requiredSpecialItem":"Отыскать обломки корабля"},{"id":"event_mseszuqn_stage_mset2t2q","label":"Этап 2","reqResource":"Alchemy","dc":14,"requiredSpecialItem":"Выкрасть артефакт из обломков, минуя гарпий"},{"id":"event_mseszuqn_stage_mset3fiq","label":"Этап 3","reqResource":"Equipment","dc":13,"requiredSpecialItem":"Не дать наемникам других организация забрать артефакт"}],"rewardSpecialItems":["Армиллярная сфера Гаранхира"],"prerequisiteMissionIds":[],"prerequisiteMode":"ALL","complications":{"enabled":true,"chancePerSlot":0.03,"baseDc":12,"allowMultiple":true},"pinned":true,"successText":"Группа успешно отыскала до, что осталось от корабля. Галеон «Морской Ворон» был завлечен на рифы ядовитым пением гарпий. Группе удалось заполучить артефакт и не позволить другим наемникам забрать её.\n\nИз затопленного ларца извлечена \"Армиллярная сфера Гаранхира\". Это сложнейший прибор из потемневших бронзовых колец, намертво заклиненных под определенным углом, с пульсирующим бирюзовым кристаллом в центре. ","failText":"Задание провалено, чтобы не было этим мистическим артефактом, этого мы уже никогда не узнаем...","unlocksMissionIds":[],"scoutedByClanIds":[]},{"id":"event_msetc8xe","title":"Координаты Армиллярной Сферы Гаранхира","desc":"Орден Истока исследовал полученную сферу. Под сфокусированным светом луны она спроецировала на стену точную карту: координаты ведут к дальним водам Манстера. Без сомнений там что-то есть, но стоит хорошо подготовиться...\nВаша задача - провести первичную разведку и оценить риски. Как только соберете информацию, возвращайтесь в штаб для подготовки полноценной операции","reqResource":"Supplies","dc":13,"type":"STORY","lifespan":null,"maxLifespan":null,"x":69.5,"y":89.3,"region":"ГЛУБОКИЕ ВОДЫ","startDay":1,"goldReward":0,"checks":[{"id":"event_msetc8xe_stage_1","label":"Добраться до координат","reqResource":"Supplies","dc":13},{"id":"event_msetc8xe_stage_mseth7qt","label":"Исследовать местность","reqResource":"Equipment","dc":15},{"id":"event_msetc8xe_stage_msetpxnd","label":"Защититься от местных угроз","reqResource":"Equipment","dc":14}],"rewardSpecialItems":[],"prerequisiteMissionIds":["event_mseszuqn"],"prerequisiteMode":"ALL","complications":{"enabled":true,"chancePerSlot":0.03,"baseDc":12,"allowMultiple":true},"pinned":true,"successText":"Координаты указывают на поверхностные кораллы, за которые зацепился скелет гигантского существа, лежащий здесь явно не один десяток лет.\nНахождение вблизи скелета видоизменяет организм посредством крайней пугающих метаморфоз, в результате которых люди обучаются дыханию под водой.\nРазведка подтвердила, что мистическим способом давление воды рядом со скелетом крайне сильно ослаблено.","failText":"Операция провалена. Остается лишь молиться, что у нас будет ещё один шанс...","unlocksMissionIds":[],"scoutedByClanIds":[]},{"id":"event_msetc8xe_copy_mseto4xn","title":"Спуск на Дно Океана","desc":"Выдвинута гипотеза, что найденный скелет является неким подобием лестницы на дно океана.\nЗадача группы - проверить эту гипотезу и вернуться с полным донесением","reqResource":"Supplies","dc":13,"type":"STORY","lifespan":null,"maxLifespan":null,"x":74.5,"y":89,"region":"ГЛУБОКИЕ ВОДЫ","startDay":1,"goldReward":0,"checks":[{"id":"event_msetc8xe_copy_mseto4xn_stage_1","label":"Добраться до координат","reqResource":"Supplies","dc":13},{"id":"event_msetc8xe_copy_mseto4xn_stage_2","label":"Спуститься на дно океана","reqResource":"Equipment","dc":15},{"id":"event_msetc8xe_copy_mseto4xn_stage_msetqh2p","label":"???","reqResource":"None","dc":15}],"rewardSpecialItems":[],"prerequisiteMissionIds":["event_msetc8xe"],"prerequisiteMode":"ALL","complications":{"enabled":true,"chancePerSlot":0.03,"baseDc":12,"allowMultiple":true},"pinned":true,"successText":"Исследование скелета чудовища привело отряд в общину на дне океана, что зовется \"Хранители Савана\", они говорят на Древневаллийском, так что коммуникация с ними затруднена.\nОни не враждебны, по крайней мере не ко всем, и там же находится некая \"Библиотека Савана\", чем бы она не была.\n","failText":"Операция провалена. Остается лишь молиться, что у нас будет ещё один шанс...","unlocksMissionIds":[],"scoutedByClanIds":[]},{"id":"event_msett0ra","title":"Замерзший Корабль","desc":"Вокруг островов постоянно происходит всякая чертовщина, но один из таких слухов повторяется с пугающей регулярностью.\nМоряки молвят, будто иногда в ночи, в глубоких водах Ленстера видят облако застывшего тумана, которое разрастается, и всякий, кого оно поглотит, не возвращается...\nЗадача отряда - отыскать это облако и понять уровень угрозы","reqResource":"Intelligence","dc":11,"type":"STORY","lifespan":null,"maxLifespan":null,"x":98.6,"y":52,"region":"ГЛУБОКИЕ ВОДЫ","startDay":2,"goldReward":0,"checks":[{"id":"event_msett0ra_stage_1","label":"Отыскать мистический туман","reqResource":"Intelligence","dc":11},{"id":"event_msett0ra_stage_msetym0v","label":"Провести разведку","reqResource":"Equipment","dc":12},{"id":"event_msett0ra_stage_msetz365","label":"Выжить","reqResource":"None","dc":15}],"rewardSpecialItems":["Бортовой журнал на Древневаллийском"],"prerequisiteMissionIds":[],"prerequisiteMode":"ALL","complications":{"enabled":true,"chancePerSlot":0.03,"baseDc":12,"allowMultiple":true},"pinned":true,"successText":"Группа обнаружила \"дышаший\" ледник. На нем множество разбитых кораблей, место действительно смертельно опасно.\nОднако среди прочего был обнаружен древний корабль, его исследование принесло нам Бортовой журнал на Древневаллийском, мы немедленно приступаем к его расшифровке.","failText":"Операция провалена. Нужно провести повторную оценку значимости этих баек.","unlocksMissionIds":[],"scoutedByClanIds":[]},{"id":"event_mseu92ix","title":"Расследование по Записям Бортового Журнала","desc":"Хоть записи и были сильно повреждены, нам удалось восстановить часть информации, остается верить, что мы верно их перевели.\nМы узнали, что корабль принадлежал великому дому Стражей Волн Гвейлода. Они были отправлены, чтобы выследить и вернуть беглецов-предателей из 7го дома.\nЕсли мы верно поняли, они украли четыре великих щита и бежали в сторону сердца острова. Однако корабль попал в засаду фоморов и был уничтожен. \nПо восстановленным данным мы можем предположить примерные координаты, куда сбежали беглецы. имеет смысл их проверить.","reqResource":"Intelligence","dc":14,"type":"STORY","lifespan":null,"maxLifespan":null,"x":55.9,"y":44.9,"region":"ЛЕНСТЕР","startDay":1,"goldReward":0,"checks":[{"id":"event_mseu92ix_stage_1","label":"Исследовать область на аномалии","reqResource":"Intelligence","dc":14},{"id":"event_mseu92ix_stage_mseuiv7n","label":"Выжить","reqResource":"Equipment","dc":14}],"rewardSpecialItems":[],"prerequisiteMissionIds":["event_msett0ra"],"prerequisiteMode":"ALL","complications":{"enabled":true,"chancePerSlot":0.03,"baseDc":12,"allowMultiple":true},"unlocksMissionIds":[],"pinned":true,"successText":"Сердцем острова было озеро, однако группа отыскала ритуал, делающий из озера что-то на подобии портала.\nОн ведет к древнему устройству в странном месте, группе удалось его активировать.\nТеперь от него идут четверо врат, ведущие в странные места...","failText":"Операция провалена. Мы должны продолжить поиски, это не может быть просто след в никуда...","scoutedByClanIds":[]},{"id":"event_mseu92ix_copy_mseuohnm","title":"Белый Портал","desc":"Это один из порталов от древнего устройства.\nМы понятия не имеем куда он ведет, но просто обязаны это выяснить...","reqResource":"Supplies","dc":8,"type":"STORY","lifespan":null,"maxLifespan":null,"x":54.1,"y":44.9,"region":"ЛЕНСТЕР","startDay":1,"goldReward":0,"checks":[{"id":"event_mseu92ix_copy_mseuohnm_stage_1","label":"Отправиться в Портал","reqResource":"Supplies","dc":8},{"id":"event_mseu92ix_copy_mseuohnm_stage_2","label":"???","reqResource":"None","dc":15},{"id":"event_mseu92ix_copy_mseuohnm_stage_mseurole","label":"Выжить","reqResource":"Equipment","dc":15}],"rewardSpecialItems":[],"prerequisiteMissionIds":["event_mseu92ix"],"prerequisiteMode":"ALL","complications":{"enabled":true,"chancePerSlot":0.03,"baseDc":12,"allowMultiple":true},"unlocksMissionIds":[],"pinned":true,"successText":"Сердцем острова было озеро, однако группа отыскала ритуал, делающий из озера что-то на подобии портала.\nОн ведет к древнему устройству в странном месте, от него идут четверо врат, ведущие в странные места...","failText":"Операция провалена. Мы должны продолжить поиски, это не может быть просто след в никуда...","scoutedByClanIds":[]},{"id":"event_mseu92ix_copy_mseuohnm_copy_mseuse3y","title":"Зеленый Портал","desc":"Это один из порталов от древнего устройства.\nМы понятия не имеем куда он ведет, но просто обязаны это выяснить...","reqResource":"Supplies","dc":8,"type":"STORY","lifespan":null,"maxLifespan":null,"x":55.9,"y":46.1,"region":"ЛЕНСТЕР","startDay":1,"goldReward":0,"checks":[{"id":"event_mseu92ix_copy_mseuohnm_copy_mseuse3y_stage_1","label":"Отправиться в Портал","reqResource":"Supplies","dc":8},{"id":"event_mseu92ix_copy_mseuohnm_copy_mseuse3y_stage_2","label":"???","reqResource":"None","dc":15},{"id":"event_mseu92ix_copy_mseuohnm_copy_mseuse3y_stage_3","label":"Выжить","reqResource":"Equipment","dc":15}],"rewardSpecialItems":[],"prerequisiteMissionIds":["event_mseu92ix"],"prerequisiteMode":"ALL","complications":{"enabled":true,"chancePerSlot":0.03,"baseDc":12,"allowMultiple":true},"unlocksMissionIds":[],"pinned":true,"successText":"Сердцем острова было озеро, однако группа отыскала ритуал, делающий из озера что-то на подобии портала.\nОн ведет к древнему устройству в странном месте, от него идут четверо врат, ведущие в странные места...","failText":"Операция провалена. Мы должны продолжить поиски, это не может быть просто след в никуда...","scoutedByClanIds":[]},{"id":"event_mseu92ix_copy_mseuohnm_copy_mseuse3y_copy_mseusevv","title":"Красный Портал","desc":"Это один из порталов от древнего устройства.\nМы понятия не имеем куда он ведет, но просто обязаны это выяснить...","reqResource":"Supplies","dc":8,"type":"STORY","lifespan":null,"maxLifespan":null,"x":57.6,"y":44.9,"region":"ЛЕНСТЕР","startDay":1,"goldReward":0,"checks":[{"id":"event_mseu92ix_copy_mseuohnm_copy_mseuse3y_copy_mseusevv_stage_1","label":"Отправиться в Портал","reqResource":"Supplies","dc":8},{"id":"event_mseu92ix_copy_mseuohnm_copy_mseuse3y_copy_mseusevv_stage_2","label":"???","reqResource":"None","dc":15},{"id":"event_mseu92ix_copy_mseuohnm_copy_mseuse3y_copy_mseusevv_stage_3","label":"Выжить","reqResource":"Equipment","dc":15}],"rewardSpecialItems":[],"prerequisiteMissionIds":["event_mseu92ix"],"prerequisiteMode":"ALL","complications":{"enabled":true,"chancePerSlot":0.03,"baseDc":12,"allowMultiple":true},"unlocksMissionIds":[],"pinned":true,"successText":"Сердцем острова было озеро, однако группа отыскала ритуал, делающий из озера что-то на подобии портала.\nОн ведет к древнему устройству в странном месте, от него идут четверо врат, ведущие в странные места...","failText":"Операция провалена. Мы должны продолжить поиски, это не может быть просто след в никуда...","scoutedByClanIds":[]},{"id":"event_mseu92ix_copy_mseuohnm_copy_mseuse3y_copy_mseusevv_copy_mseusf7k","title":"Желтый Портал","desc":"Это один из порталов от древнего устройства.\nМы понятия не имеем куда он ведет, но просто обязаны это выяснить...","reqResource":"Supplies","dc":8,"type":"STORY","lifespan":null,"maxLifespan":null,"x":55.9,"y":43.6,"region":"ЛЕНСТЕР","startDay":1,"goldReward":0,"checks":[{"id":"event_mseu92ix_copy_mseuohnm_copy_mseuse3y_copy_mseusevv_copy_mseusf7k_stage_1","label":"Отправиться в Портал","reqResource":"Supplies","dc":8},{"id":"event_mseu92ix_copy_mseuohnm_copy_mseuse3y_copy_mseusevv_copy_mseusf7k_stage_2","label":"???","reqResource":"None","dc":15},{"id":"event_mseu92ix_copy_mseuohnm_copy_mseuse3y_copy_mseusevv_copy_mseusf7k_stage_3","label":"Выжить","reqResource":"Equipment","dc":15}],"rewardSpecialItems":[],"prerequisiteMissionIds":["event_mseu92ix"],"prerequisiteMode":"ALL","complications":{"enabled":true,"chancePerSlot":0.03,"baseDc":12,"allowMultiple":true},"unlocksMissionIds":[],"pinned":true,"successText":"Сердцем острова было озеро, однако группа отыскала ритуал, делающий из озера что-то на подобии портала.\nОн ведет к древнему устройству в странном месте, от него идут четверо врат, ведущие в странные места...","failText":"Операция провалена. Мы должны продолжить поиски, это не может быть просто след в никуда...","scoutedByClanIds":[]},{"id":"event_mseuu5r1","title":"Ты не представляешь...","desc":"Из Манстера продолжают поступать донесения, что иногда его жители пропадают на пару дней и возвращаются навеселе и ещё более не от мира сего, чем обычно...\nНичего общего в донесениях \"пропавших\" нет, самое часто повторяющееся выражение: \"Ты не представляешь где я был и что я там видел... Только жене моей не говори\"\nТому, что они рассказывали никто из опрошенных и вправду не верил","reqResource":"Intelligence","dc":8,"type":"OPERATION","lifespan":null,"maxLifespan":null,"x":55.5,"y":67.4,"region":"МАНСТЕР","startDay":3,"goldReward":0,"checks":[{"id":"event_mseuu5r1_stage_1","label":"Проверить слухи","reqResource":"Intelligence","dc":8}],"rewardSpecialItems":[],"prerequisiteMissionIds":[],"prerequisiteMode":"ALL","complications":{"enabled":true,"chancePerSlot":0.03,"baseDc":12,"allowMultiple":true},"successText":"Что-же, на удивление слухи взялись не из неоткуда.\nГруппе удалось выявить единственное общее место, которое хоть как-то фигурирует в рассказах опрошенных\nЭто подводная пещера, открывающаяся во время отлива, группа нашла место входа, но решила не рисковать без необходимости","failText":"Операция провалена. В следующий раз трижды подумаем прежде, чем отправлять кого-то на такие \"расследовани\"","unlocksMissionIds":[],"scoutedByClanIds":[]},{"id":"event_mseuu5r1_copy_msev7s58","title":"Где я был...","desc":"В ходе прошлой операции была найдена пещера, где \"пропадают\" люди\nЗадача группы - исследовать пещеру","reqResource":"Equipment","dc":10,"type":"OPERATION","lifespan":null,"maxLifespan":null,"x":43,"y":61.3,"region":"МАНСТЕР","startDay":4,"goldReward":0,"checks":[{"id":"event_mseuu5r1_copy_msev7s58_stage_1","label":"Исследовать пещеру","reqResource":"Equipment","dc":10}],"rewardSpecialItems":[],"prerequisiteMissionIds":["event_mseuu5r1"],"prerequisiteMode":"ALL","complications":{"enabled":true,"chancePerSlot":0.03,"baseDc":12,"allowMultiple":true},"successText":"Часть пещеры плотно поросла грибами, оказывающими галлюциногенный эффект на находящихся рядом.\nГруппа утверждает, что видела как грибы приглашали их войти в них, но отказывали им, т.к. у них нет некого \"Споровго Ключа\"\nОперативники решили не спорить с грибами и покинули место.\nПо возвращению на участвовавших в вылазке были обнаружены многие повреждения, но они утверждают, что не знают откуда они их получили...\n","failText":"Операция провалена. В следующий раз трижды подумаем прежде, чем отправлять кого-то на такие \"расследования\"","unlocksMissionIds":[],"scoutedByClanIds":[]},{"id":"event_mseuu5r1_copy_msev7s58_copy_msevgqku","title":"И что я там видел...","desc":"В ходе прошлой операции была найдена пещера, где \"пропадают\" люди\nЗадача группы - исследовать пещеру","reqResource":"Supplies","dc":8,"type":"STORY","lifespan":null,"maxLifespan":null,"x":44.7,"y":61.4,"region":"МАНСТЕР","startDay":9,"goldReward":0,"checks":[{"id":"event_mseuu5r1_copy_msev7s58_copy_msevgqku_stage_1","label":"Ты не представляешь...","reqResource":"Supplies","dc":8,"requiredSpecialItem":"Споровый Ключ"},{"id":"event_mseuu5r1_copy_msev7s58_copy_msevgqku_stage_msevjsj6","label":"Гле я был...","reqResource":"Alchemy","dc":8},{"id":"event_mseuu5r1_copy_msev7s58_copy_msevgqku_stage_msevk6of","label":"И что я там видел...","reqResource":"Alchemy","dc":8}],"rewardSpecialItems":[],"prerequisiteMissionIds":["event_mseuu5r1_copy_msev7s58_copy_msevgqku_copy_msevh3j5","event_mseuu5r1_copy_msev7s58"],"prerequisiteMode":"ALL","complications":{"enabled":true,"chancePerSlot":0.03,"baseDc":12,"allowMultiple":true},"successText":"Часть пещеры плотно поросла грибами, оказывающими галлюциногенный эффект на находящихся рядом.\nГруппа утверждает, что видела как грибы приглашали их войти в них, но отказывали им, т.к. у них нет некого \"Споровго Ключа\"\nОперативники решили не спорить с грибами и покинули место.\nПо возвращению на участвовавших в вылазке были обнаружены многие повреждения, но они утверждают, что не знают откуда они их получили...\n","failText":"Операция провалена. В следующий раз трижды подумаем прежде, чем отправлять кого-то на такие \"расследования\"","pinned":false,"unlocksMissionIds":[],"scoutedByClanIds":[]},{"id":"event_mseuu5r1_copy_msev7s58_copy_msevgqku_copy_msevh3j5","title":"Драка из-за спорового ключа","desc":"Поступило донесение, что в Манстере одновременно произошло несколько крупных драк сразу в нескольких городах\nПо заявлению сразу нескольких информаторов причиной оказался некий \"Споровый Ключ\"...","reqResource":"Alchemy","dc":8,"type":"OPERATION","lifespan":2,"maxLifespan":2,"x":27.6,"y":73.1,"region":"МАНСТЕР","startDay":8,"goldReward":0,"checks":[{"id":"event_mseuu5r1_copy_msev7s58_copy_msevgqku_copy_msevh3j5_stage_1","label":"Опросить участников драки","reqResource":"Alchemy","dc":8},{"id":"event_mseuu5r1_copy_msev7s58_copy_msevgqku_copy_msevh3j5_stage_msevrdel","label":"Найти Споровый Ключ","reqResource":"Equipment","dc":12}],"rewardSpecialItems":["Споровый Ключ"],"prerequisiteMissionIds":[],"prerequisiteMode":"ALL","complications":{"enabled":true,"chancePerSlot":0.03,"baseDc":12,"allowMultiple":true},"successText":"Участники драки утверждают, что каждый украл у кого-то их драгоценный Споровый Ключ\nЧто это такое никто из них объяснить так и не смог\nПартия сумела составит крупицы информации и проследовать к центру Манстера\nТам они нашли, по их словам, колонию ходячих грибов, которые отдали им споровый ключ\nТеперь он у нас есть.\nЭто... ну... в общем,..","failText":"Операция провалена. Кажется теперь мы никогда не узнаем причин массового психоза...","unlocksMissionIds":[],"scoutedByClanIds":[]},{"id":"event_msevml56","title":"Пропавший груз","desc":"Портовые работники утверждают, что кто-то украл четыре ящика спиртных напитков\nПо их словам, ограбление произошло в сильный ливень с туманом и те готовы поклясться, что видели как странные силуэты прокрадываются на склад","reqResource":"None","dc":12,"type":"DUMMY","lifespan":3,"maxLifespan":3,"x":30.1,"y":39.4,"region":"КОННАХТ","startDay":1,"goldReward":0,"checks":[{"id":"event_msevml56_stage_1","label":"Этап 1","reqResource":"None","dc":12}],"rewardSpecialItems":[],"prerequisiteMissionIds":[],"prerequisiteMode":"ALL","complications":{"enabled":true,"chancePerSlot":0.03,"baseDc":12,"allowMultiple":true},"unlocksMissionIds":[],"successText":"Работники нагло врали. \nЯщики были найдены у них дома, уже частично опустошенные.","scoutedByClanIds":[]}]},"map":{"fileName":"GlobalMap.webp","mimeType":"image/webp","base64":""}}